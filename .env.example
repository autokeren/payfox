# PayFox — AI Shopping Agent
# ─────────────────────────────────────────────

# Meta Muse (required — same as Kancil)
META_API_KEY=LLM_xxx
META_MESSENGER_VERIFY_TOKEN=payfox-verify
META_MESSENGER_PAGE_ACCESS_TOKEN=xxx

# PayPal (required for shopping)
# Get these from: https://developer.paypal.com/dashboard/applications
# Create App → Sandbox → copy Client ID + Secret
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
# Leave unset for sandbox (default), set to 1 for live mode
# PAYPAL_LIVE=1

# Optional: MCP browser server
# GHOSTFOX_MCP_PATH=/data/ghostfox/monorepo/runtime/target/release/ghostfox-mcp
